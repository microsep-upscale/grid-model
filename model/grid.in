&params
! --- Geometry ---
block_size_x = 0.1d-9     ! block size along x (transport direction), m
block_size_y = 10d-9     ! cross-section height, m
block_size_z = 10d-9     ! cross-section height, m
system_size_x = 100d-9  ! total pore length, m

! --- Time integration ---
time_step = 1e-15       ! initial timestep, s
max_time_step = 1e-10   ! cap on timestep growth, s

! --- Boundary conditions ---
left_mu = -1d0        ! left reservoir chemical potential, kcal/mol
inside_mu = -10d0       ! inside the pore, kcal/mol (only usefull when mu_mode = 1)
right_mu = -10.0d0      ! right reservoir chemical potential, kcal/mol
mu_mode = 1             ! 1=linear slope, 2=constant mu inside using inside_mu

! --- Run control ---
n_iter = 500000000       ! max iterations
n_jump = 500000          ! profile output interval
check_interval = 10000  ! timestep/convergence check interval
conv_tol = 1e-3         ! flux conservation convergence tolerance
steady_tol = 1d-6
n_steady = 5
tol_min = 1e-7
tol_max = 1e-5

! --- Isotherm data ---
rho_spline_file = "../data/T300/h1.0/spline_rho_vs_mu.txt"
M_spline_file = "../data/T300/h1.0/spline_M_vs_mu.txt"

! --- Output ---
output_dir = "output_0.1"   ! directory for logs, conservation.dat, and profile files
/
